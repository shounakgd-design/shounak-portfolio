{
  "name": "shounak-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend-src",
    "backend-src"
  ],
  "scripts": {
    "dev": "node run-dev.js",
    "start": "npm run start:prod --workspace=backend-src",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend-src",
    "build:backend": "npm run build --workspace=backend-src"
  }
}
